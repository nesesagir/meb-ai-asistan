# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# .env dosyasını asla Git'e / sohbete / ekran görüntüsüne eklemeyin.
# Anahtar gsk_ ile baslar (Groq). Dusurse hemen console.groq.com'dan sil + yenile.

GROQ_API_KEY=buraya_yeni_groq_anahtariniz
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=meb-books-v2
OLLAMA_MODEL=llama3
LLM_PROVIDER=groq
GROQ_LLM_MODEL=llama-3.1-8b-instant
TTS_VOICE_TR=tr-TR-EmelNeural
TTS_VOICE_EN=en-US-AndrewNeural
